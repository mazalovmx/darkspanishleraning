  "locations": [
    {
      "id": "LOC01",
      "name": "Monasterio de Santa Lucerna",
      "position": [
        52,
        39
      ],
      "kind": "monastery",
      "description": "Un monasterio de copistas y médicos. La lluvia cae sobre el patio de la torre. Nadie mira hacia arriba desde hace días."
    },
    {
      "id": "LOC02",
      "name": "Valdora",
      "position": [
        63,
        66
      ],
      "kind": "capital",
      "description": "Fachadas de mármol, tejados con goteras y las oficinas del Tribunal. El mármol es para los visitantes; las goteras, para todos los demás."
    },
    {
      "id": "LOC03",
      "name": "Miralba",
      "position": [
        105,
        48
      ],
      "kind": "university",
      "description": "Librerías, lentes y estudiantes llenan las calles de la universidad. Aquí se discute de todo, y sobre todo de quién paga."
    },
    {
      "id": "LOC04",
      "name": "Ferraza",
      "position": [
        114,
        78
      ],
      "kind": "industrial",
      "description": "Ruedas hidráulicas y hornos trabajan junto al barrio de los obreros. Los hornos descansan más que los obreros."
    },
    {
      "id": "LOC05",
      "name": "Cárdena",
      "position": [
        126,
        105
      ],
      "kind": "port",
      "description": "El puerto recibe libros extranjeros, instrumentos y mercancías sin declarar. Las mercancías declaradas son pocas y sirven de excusa."
    },
    {
      "id": "LOC06",
      "name": "Puente Seco",
      "position": [
        103,
        68
      ],
      "kind": "customs",
      "description": "El río sigue lleno. En el puente se revisan las cargas y los permisos. A veces, incluso, se revisan bien."
    },
    {
      "id": "LOC07",
      "name": "San Vélaro",
      "position": [
        33,
        26
      ],
      "kind": "town",
      "description": "Graneros, un depósito militar y un camino de peregrinos bajo el frío. Este invierno los graneros tienen más eco que grano."
    },
    {
      "id": "LOC08",
      "name": "Minas de Bruma",
      "position": [
        92,
        22
      ],
      "kind": "mine",
      "description": "Las galerías producen hierro y plata. El aire cuesta más que el mineral."
    },
    {
      "id": "LOC09",
      "name": "Monte Ciego",
      "position": [
        48,
        8
      ],
      "kind": "ruin",
      "description": "Un pico remoto. Entre la nieve sobresalen muros de una estación antigua. Los peregrinos suben por un milagro y bajan con menos dinero."
    },
    {
      "id": "LOC10",
      "name": "Marjal Negro",
      "position": [
        39,
        94
      ],
      "kind": "marsh",
      "description": "Agua oscura, cañaverales y restos de una calzada hundida. Lo que se hunde aquí no vuelve; lo que vuelve, se vende."
    },
    {
      "id": "LOC11",
      "name": "Venta del Perro Negro",
      "position": [
        74,
        59
      ],
      "kind": "inn",
      "description": "Una posada en el camino. Un lugar de encuentro para viajeros. Camas duras, vino flojo y noticias caras."
    },
    {
      "id": "LOC12",
      "name": "Granja Arce",
      "position": [
        46,
        55
      ],
      "kind": "farm",
      "description": "Sacos de grano, un horno y carros esperan junto al camino. Esperar es lo que mejor se hace aquí."
    },
    {
      "id": "LOC13",
      "name": "Taller Rojo",
      "position": [
        117,
        73
      ],
      "kind": "workshop",
      "description": "Los mecánicos ajustan bombas y ruedas entre polvo rojo. Aquí todo funciona, menos el horario."
    },
    {
      "id": "LOC14",
      "name": "Archivo Episcopal",
      "position": [
        66,
        62
      ],
      "kind": "archive",
      "description": "Estantes, sellos y formularios regulan el acceso a los documentos. Entrar es difícil. Salir con un documento, más."
    },
    {
      "id": "LOC15",
      "name": "Hospital de Miralba",
      "position": [
        107,
        51
      ],
      "kind": "hospital",
      "description": "Aquí se atiende a enfermos y se comparan observaciones médicas. Huele a alcohol, a sopa y a miedo."
    },
    {
      "id": "LOC16",
      "name": "Casa de Impresores",
      "position": [
        71,
        70
      ],
      "kind": "guildhouse",
      "description": "Prensas, tipos móviles y permisos de copia llenan el taller. Imprimir es barato; el permiso, no."
    },
    {
      "id": "LOC17",
      "name": "Campamento del Puente",
      "position": [
        93,
        82
      ],
      "kind": "camp",
      "description": "Un refugio discreto junto a los caminos de las caravanas. Aquí nadie pregunta nombres: cuestan demasiado."
    },
    {
      "id": "LOC18",
      "name": "Torre del Relé",
      "position": [
        50,
        10
      ],
      "kind": "ruin",
      "description": "Una torre sin campana domina el paso de montaña. De noche, algo dentro todavía hace clic."
    }
  ],
